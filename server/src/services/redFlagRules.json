{
  "version": "1.0.0",
  "rules": [
    {
      "ruleId": "RF_ACS_01",
      "code": "CARDIO_DYSPNOEA",
      "name": "Suspected Acute Coronary Syndrome (Chest Pain + Dyspnoea/Radiation)",
      "category": "Cardiovascular",
      "severity": "critical",
      "priorityBoost": 45,
      "matchType": "compound_and",
      "primaryKeywords": [
        "chest pain",
        "retrosternal pain",
        "precordial pain",
        "chest tightness",
        "heaviness in chest",
        "hridshoola"
      ],
      "secondaryKeywords": [
        "dyspnoea",
        "dyspnea",
        "shortness of breath",
        "breathlessness",
        "sweating",
        "diaphoresis",
        "left arm",
        "jaw pain",
        "shwasa"
      ],
      "rationale": "Concurrent chest pain and dyspnoea/autonomic symptoms or radiation indicates potential Acute Coronary Syndrome requiring immediate ECG and triage."
    },
    {
      "ruleId": "RF_STROKE_02",
      "code": "NEURO_FAST_STROKE",
      "name": "Acute Neurological Deficit / Stroke Signs (FAST)",
      "category": "Neurological",
      "severity": "critical",
      "priorityBoost": 50,
      "matchType": "any",
      "keywords": [
        "facial droop",
        "slurred speech",
        "limb weakness",
        "hemiparesis",
        "hemiplegia",
        "pakshaghata",
        "sudden numbness",
        "inability to speak",
        "aphasia",
        "one-sided weakness"
      ],
      "rationale": "Focal neurological deficits (facial droop, slurred speech, limb weakness / Pakshaghata) require immediate stroke protocol activation."
    },
    {
      "ruleId": "RF_HEMORRHAGE_03",
      "code": "HEMORRHAGE_SHOCK",
      "name": "Severe Active Bleeding / Hemorrhagic Warning",
      "category": "Hematological / Trauma",
      "severity": "critical",
      "priorityBoost": 45,
      "matchType": "any",
      "keywords": [
        "severe bleeding",
        "uncontrolled bleeding",
        "hematemesis",
        "vomiting blood",
        "hemoptysis",
        "coughing blood",
        "melena",
        "profuse bleeding",
        "raktapitta"
      ],
      "rationale": "Active severe bleeding or gastrointestinal/respiratory hemorrhage risks hypovolemic shock and hemodynamic instability."
    },
    {
      "ruleId": "RF_ANAPHYLAXIS_04",
      "code": "ALLERGY_ANAPHYLAXIS",
      "name": "Suspected Anaphylaxis / Airway Compromise",
      "category": "Immunological / Airway",
      "severity": "critical",
      "priorityBoost": 50,
      "matchType": "any",
      "keywords": [
        "anaphylaxis",
        "tongue swelling",
        "throat swelling",
        "stridor",
        "airway obstruction",
        "hives with breathing difficulty",
        "angioedema",
        "difficulty swallowing with wheezing"
      ],
      "rationale": "Signs of upper airway edema, stridor, or systemic anaphylaxis demand immediate airway protection and epinephrine."
    },
    {
      "ruleId": "RF_SEPSIS_MENINGISM_05",
      "code": "INFECT_MENINGISM",
      "name": "High Fever with Altered Sensorium / Meningism",
      "category": "Infectious / CNS",
      "severity": "high",
      "priorityBoost": 35,
      "matchType": "compound_and",
      "primaryKeywords": [
        "high fever",
        "hyperpyrexia",
        "severe fever",
        "sannipata jwara",
        "fever"
      ],
      "secondaryKeywords": [
        "neck stiffness",
        "altered sensorium",
        "confusion",
        "delirium",
        "photophobia",
        "seizure",
        "unresponsive",
        "murchha"
      ],
      "rationale": "Fever accompanied by meningeal signs or altered consciousness raises suspicion for CNS infection or sepsis."
    },
    {
      "ruleId": "RF_SEVERE_PAIN_06",
      "code": "CRITICAL_PAIN_SCORE",
      "name": "Extreme Pain Severity Score (VAS >= 9/10)",
      "category": "General Triage",
      "severity": "high",
      "priorityBoost": 25,
      "matchType": "severity_threshold",
      "minSeverity": 9,
      "rationale": "Patient reported pain severity >= 9/10 on HPI Visual Analog Scale requires rapid analgesic and diagnostic triage."
    }
  ],
  "standardLabRanges": {
