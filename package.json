{
  "name": "medikiosk",
  "version": "1.0.0",
  "description": "MediKiosk - SIH26047 Patient Case-Taking Software (Ministry of Ayush / AIIA) - CSE494 Intelligent NoSQL Databases Mini-Project",
  "private": true,
  "scripts": {
    "dev": "nodemon server/src/server.js",
    "start": "node server/src/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "node server/src/seed/seed.js",
    "seed:bulk": "node server/src/seed/seed.js --bulk 100000",
    "benchmark": "node server/src/scripts/benchmark.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.0",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4",
    "vite": "^5.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/src/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}